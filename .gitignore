# E-commerce Git Ignore Rules

# Ignore package files globally
package.json
package-lock.json

# Root dependencies (make single node_modules)
/node_modules/

# Front-end sub-directory dependencies & builds
front-end/node_modules/
front-end/build/
front-end/.pnp
front-end/.pnp.js
front-end/coverage/
front-end/npm-debug.log*
front-end/yarn-debug.log*
front-end/yarn-error.log*
front-end/.env*

# OS specific files
.DS_Store
Thumbs.db
