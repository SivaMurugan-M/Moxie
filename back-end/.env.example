# Django Core Settings
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=moxie-backend.onrender.com,localhost,127.0.0.1

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=https://moxie-frontend.onrender.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://moxie-frontend.onrender.com,https://moxie-backend.onrender.com

# Razorpay Payment Gateway Credentials (Test/Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional Production Database (PostgreSQL)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=moxie_db
# DB_USER=moxie_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432
