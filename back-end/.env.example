# Django Core Settings
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=moxie-backend-9bar.onrender.com,.onrender.com,localhost,127.0.0.1,*

# CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://your-app-name.netlify.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-app-name.netlify.app,https://moxie-backend-9bar.onrender.com

# Razorpay Payment Gateway Credentials (Test/Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional Production Database (PostgreSQL)
# DATABASE_URL=postgres://user:password@host:port/dbname
